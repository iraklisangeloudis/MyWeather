<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient"
    android:fitsSystemWindows="true">
    <FrameLayout
        android:id="@+id/weatherHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">
        <LinearLayout
            android:id="@+id/locationHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="56dp"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:id="@+id/textViewCityName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="24sp"
                android:textColor="@color/weather_ink"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/locationContext"
                style="@style/WeatherLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/weather_home" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/searchSurface"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/weather_action">
            <LinearLayout
                android:id="@+id/searchRow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingEnd="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="14dp"
                    android:src="@drawable/weather_search_icon"
                    app:tint="@color/weather_muted"
                    android:importantForAccessibility="no" />
                <EditText
                    android:id="@+id/editTextLocation"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="0dp"
                    android:hint="@string/search_hint"
                    android:inputType="textCapWords"
                    android:imeOptions="actionSearch"
                    android:singleLine="true"
                    android:textSize="16sp"
                    android:textColor="@color/weather_ink"
                    android:textColorHint="@color/weather_muted" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/searchButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/weather_search_icon"
                app:tint="@color/weather_ink"
                android:contentDescription="@string/search_city" />
        </FrameLayout>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.example.myweather.features.weather.ui.DotSwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.core.widget.NestedScrollView
                android:id="@+id/weatherScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:clipToPadding="false">
                <LinearLayout
                    android:id="@+id/weatherContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="28dp">
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp">
                        <com.airbnb.lottie.LottieAnimationView
                            app:lottie_enableMergePathsForKitKatAndAbove="true"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            app:lottie_rawRes="@raw/weather_partly_cloudy_day"
                            android:importantForAccessibility="no" />
                        <TextView
                            style="@style/WeatherTitle"
                            android:text="@string/empty_title"
                            android:textSize="20sp"
                            android:gravity="center"
                            android:layout_marginTop="24dp" />
                        <TextView
                            style="@style/WeatherLabel"
                            android:text="@string/empty_message"
                            android:gravity="center"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/weatherHero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="176dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingBottom="20dp"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/textViewTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="76sp"
                                android:fontFamily="sans-serif-light"
                                android:includeFontPadding="false"
                                android:textColor="@color/weather_ink" />
                            <TextView
                                android:id="@+id/textViewCondition"
                                style="@style/WeatherTitle"
                                android:layout_marginTop="6dp"
                                android:textSize="16sp" />
                            <TextView
                                android:id="@+id/textViewHighLow"
                                style="@style/WeatherLabel"
                                android:layout_marginTop="4dp" />
                        </LinearLayout>
                        <com.airbnb.lottie.LottieAnimationView
                            app:lottie_enableMergePathsForKitKatAndAbove="true"
                            android:id="@+id/imageViewWeather"
                            android:layout_width="128dp"
                            android:layout_height="128dp"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/hourlyCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/weather_panel"
                        android:padding="16dp"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone">
                        <TextView
                            style="@style/WeatherTitle"
                            android:text="@string/next_hours"
                            android:layout_marginBottom="12dp" />
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewTemperatures"
                            android:layout_width="match_parent"
                            android:layout_height="108dp"
                            android:nestedScrollingEnabled="false"
                            android:clipToPadding="false" />
                    </LinearLayout>
                    <com.example.myweather.features.weather.ui.ExpandableWeatherSection
                        android:id="@+id/metricsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:compactHeight="72dp"
                        app:summaryWhenCompact="true"
                        app:compactContentOffset="30dp"
                        android:visibility="gone">
                        <TextView style="@style/WeatherTitle" android:text="@string/weather_details" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <com.airbnb.lottie.LottieAnimationView
                                    app:lottie_enableMergePathsForKitKatAndAbove="true"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginBottom="6dp"
                                    app:lottie_rawRes="@raw/weather_thermometer"
                                    android:importantForAccessibility="no"
                                    android:tag="expanding_icon" />
                                <TextView style="@style/WeatherLabel" android:text="@string/feels_like" />
                                <TextView
                                    android:id="@+id/textViewFeelsLike"
                                    style="@style/WeatherValue"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <com.airbnb.lottie.LottieAnimationView
                                    app:lottie_enableMergePathsForKitKatAndAbove="true"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginBottom="6dp"
                                    app:lottie_rawRes="@raw/weather_humidity"
                                    android:importantForAccessibility="no"
                                    android:tag="expanding_icon" />
                                <TextView style="@style/WeatherLabel" android:text="@string/humidity" />
                                <TextView
                                    android:id="@+id/textViewHumidity"
                                    style="@style/WeatherValue"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">
                                <com.airbnb.lottie.LottieAnimationView
                                    app:lottie_enableMergePathsForKitKatAndAbove="true"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_marginBottom="6dp"
                                    app:lottie_rawRes="@raw/weather_wind"
                                    android:importantForAccessibility="no"
                                    android:tag="expanding_icon" />
                                <TextView style="@style/WeatherLabel" android:text="@string/wind" />
                                <TextView
                                    android:id="@+id/textViewWindSpeed"
                                    style="@style/WeatherValue"
                                    android:maxLines="1"
                                    android:autoSizeTextType="uniform"
                                    android:autoSizeMinTextSize="14sp"
                                    android:autoSizeMaxTextSize="22sp"
                                    android:autoSizeStepGranularity="1sp"
                                    android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.example.myweather.features.weather.ui.ExpandableWeatherSection>
                    <com.example.myweather.features.weather.ui.ExpandableWeatherSection
                        android:id="@+id/sunSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:compactHeight="76dp"
                        app:summaryWhenCompact="true"
                        android:visibility="gone">
                        <TextView style="@style/WeatherTitle" android:text="@string/sun_times" />
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:orientation="horizontal">
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="horizontal">
                                    <com.airbnb.lottie.LottieAnimationView
                                        app:lottie_enableMergePathsForKitKatAndAbove="true"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginEnd="10dp"
                                        app:lottie_rawRes="@raw/weather_sunrise"
                                        android:importantForAccessibility="no" />
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <TextView style="@style/WeatherLabel" android:text="@string/sunrise" />
                                        <TextView android:id="@+id/sunRiseTextView" style="@style/WeatherValue" />
                                    </LinearLayout>
                                </LinearLayout>
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="52dp"
                                    android:layout_weight="1"
                                    android:gravity="center"
                                    android:orientation="horizontal">
                                    <com.airbnb.lottie.LottieAnimationView
                                        app:lottie_enableMergePathsForKitKatAndAbove="true"
                                        android:layout_width="36dp"
                                        android:layout_height="36dp"
                                        android:layout_marginEnd="10dp"
                                        app:lottie_rawRes="@raw/weather_sunset"
                                        android:importantForAccessibility="no" />
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="vertical">
                                        <TextView style="@style/WeatherLabel" android:text="@string/sunset" />
                                        <TextView android:id="@+id/sunSetTextView" style="@style/WeatherValue" />
                                    </LinearLayout>
                                </LinearLayout>
                            </LinearLayout>
                            <TextView
                                android:id="@+id/daylightText"
                                style="@style/WeatherLabel"
                                android:layout_width="match_parent"
                                android:gravity="center"
                                android:layout_marginTop="12dp"
                                android:tag="expanding_detail" />
                        </LinearLayout>
                    </com.example.myweather.features.weather.ui.ExpandableWeatherSection>
                    <com.example.myweather.features.weather.ui.ExpandableWeatherSection
                        android:id="@+id/dailySection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:compactHeight="56dp"
                        android:visibility="gone">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                style="@style/WeatherTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/daily_forecast" />
                            <TextView android:id="@+id/dayCount" style="@style/WeatherLabel" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/dailyWeatherLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.example.myweather.features.weather.ui.ExpandableWeatherSection>
                    <TextView
                        android:id="@+id/textViewTime"
                        style="@style/WeatherLabel"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_marginTop="20dp" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </com.example.myweather.features.weather.ui.DotSwipeRefreshLayout>
        <LinearLayout
            android:id="@+id/searchResultsPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="12dp"
            android:visibility="gone">
            <TextView
                style="@style/WeatherTitle"
                android:id="@+id/searchResultsTitle"
                android:text="@string/search_results_title"
                android:textSize="20sp"
                />
            <TextView
                android:id="@+id/searchStatus"
                style="@style/WeatherLabel"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp"
                android:accessibilityLiveRegion="polite" />
            <ListView
                android:id="@+id/listViewLocations"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="8dp"
                android:listSelector="@android:color/transparent"
                android:clipToPadding="false"
                android:paddingBottom="20dp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
